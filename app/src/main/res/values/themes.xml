<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Cervecerias" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/signal</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialAlertDialogTheme">@style/Theme.Cervecerias.Dialog</item>
    </style>

    <style name="Theme.Cervecerias.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_high</item>
        <item name="colorPrimary">@color/signal</item>
    </style>

    <style name="TextEyebrow">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
</resources>
